{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#1C1C1C",
    "darkBgPanel": "#161616",
    "darkBgDeep": "#101010",
    "darkBgElement": "#282828",
    "darkFg": "#C6C6C6",
    "darkFgMuted": "#8E8E8E",
    "darkBorder": "#414141",
    "darkBorderActive": "#747474",
    "red": "#D71921",
    "redSoft": "#E25D55",
    "grayGreen": "#A8B5A2",
    "grayYellow": "#C9B98A",
    "grayBlue": "#9FB4C7",
    "grayCyan": "#9AB5B5",
    "grayOrange": "#C9A88C",
    "grayPurple": "#B5A3C4",
    "silverBg": "#EAEAEA",
    "silverBgPanel": "#E0E0E0",
    "silverBgElement": "#F6F6F6",
    "silverFg": "#414141",
    "silverFgMuted": "#787878",
    "silverBorder": "#BEBEBE",
    "silverBorderActive": "#969696"
  },
  "theme": {
    "primary": { "dark": "red", "light": "red" },
    "secondary": { "dark": "darkBorderActive", "light": "silverBorderActive" },
    "accent": { "dark": "red", "light": "red" },
    "error": { "dark": "redSoft", "light": "#c71218" },
    "warning": { "dark": "grayYellow", "light": "#a8813d" },
    "success": { "dark": "grayGreen", "light": "#5f7a56" },
    "info": { "dark": "grayBlue", "light": "#5a7590" },
    "text": { "dark": "darkFg", "light": "silverFg" },
    "textMuted": { "dark": "darkFgMuted", "light": "silverFgMuted" },
    "background": { "dark": "darkBg", "light": "silverBg" },
    "backgroundPanel": { "dark": "darkBgPanel", "light": "silverBgPanel" },
    "backgroundElement": { "dark": "darkBgElement", "light": "silverBgElement" },
    "border": { "dark": "darkBorder", "light": "silverBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "silverBorderActive" },
    "borderSubtle": { "dark": "darkBgElement", "light": "#d5d5d5" },
    "selectedListItemText": { "dark": "#0F0F0F", "light": "#FFFFFF" },
    "diffAdded": { "dark": "grayGreen", "light": "#5f7a56" },
    "diffRemoved": { "dark": "redSoft", "light": "#c71218" },
    "diffContext": { "dark": "darkFgMuted", "light": "silverFgMuted" },
    "diffHunkHeader": { "dark": "darkBorderActive", "light": "silverBorderActive" },
    "diffHighlightAdded": { "dark": "grayGreen", "light": "#4c6344" },
    "diffHighlightRemoved": { "dark": "redSoft", "light": "#e1594f" },
    "diffAddedBg": { "dark": "#262C25", "light": "#e4e8e2" },
    "diffRemovedBg": { "dark": "#2C1F1F", "light": "#eadfe0" },
    "diffContextBg": { "dark": "darkBgPanel", "light": "silverBgPanel" },
    "diffLineNumber": { "dark": "#6E6E6E", "light": "#a8a8a8" },
    "diffAddedLineNumberBg": { "dark": "#1F2320", "light": "#dbe1da" },
    "diffRemovedLineNumberBg": { "dark": "#241A1A", "light": "#e2d4d5" },
    "markdownText": { "dark": "darkFg", "light": "silverFg" },
    "markdownHeading": { "dark": "red", "light": "red" },
    "markdownLink": { "dark": "redSoft", "light": "#b91a20" },
    "markdownLinkText": { "dark": "grayBlue", "light": "#5a7590" },
    "markdownCode": { "dark": "grayGreen", "light": "#5f7a56" },
    "markdownBlockQuote": { "dark": "darkFgMuted", "light": "silverFgMuted" },
    "markdownEmph": { "dark": "grayYellow", "light": "#a8813d" },
    "markdownStrong": { "dark": "grayOrange", "light": "#8f7050" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "silverBorder" },
    "markdownListItem": { "dark": "redSoft", "light": "#b91a20" },
    "markdownListEnumeration": { "dark": "grayBlue", "light": "#5a7590" },
    "markdownImage": { "dark": "redSoft", "light": "#b91a20" },
    "markdownImageText": { "dark": "grayBlue", "light": "#5a7590" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "silverFg" },
    "syntaxComment": { "dark": "#8E8E8E", "light": "#9a9a9a" },
    "syntaxKeyword": { "dark": "grayPurple", "light": "#6f5a80" },
    "syntaxFunction": { "dark": "grayBlue", "light": "#4a627a" },
    "syntaxVariable": { "dark": "darkFg", "light": "silverFg" },
    "syntaxString": { "dark": "grayGreen", "light": "#5f7a56" },
    "syntaxNumber": { "dark": "grayOrange", "light": "#8f7050" },
    "syntaxType": { "dark": "grayYellow", "light": "#96793f" },
    "syntaxOperator": { "dark": "grayCyan", "light": "#5f7a76" },
    "syntaxPunctuation": { "dark": "darkFg", "light": "silverFg" }
  }
}
